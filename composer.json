{
    "name": "edukonline/kursumstufung",
    "description": "KursUmstufung App for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OCA\\KursUmstufung\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\KursUmstufung\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "require-dev": {
        "nextcloud/ocp": "^30.0",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test:unit": "phpunit --configuration phpunit.xml"
    }
}
